/* App launcher (Super+D). The previous config is in
 * ~/.config/backup-2026-11-18-rofi-migration/rofi/config.rasi */

configuration {
    modi:                "drun,run";
    show-icons:          true;
    icon-theme:          "Adwaita";
    terminal:            "kitty";
    display-drun:        "Apps";
    display-run:         "Run";
    drun-display-format: "{name}";
    /* Show one row per app, not one per desktop action (no jagged rows). */
    drun-show-actions:   false;
    matching:            "fuzzy";
    sort:                true;
    sorting-method:      "fzf";
    case-sensitive:      false;
    disable-history:     false;
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    kb-cancel:           "Escape,Control+g,Control+bracketleft";
}

@theme "~/.config/rofi/theme.rasi"
