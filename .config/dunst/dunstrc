# Notifications, styled to match Rofi, Waybar and the volume pop-up.
# Super+N brings back the last dismissed notification, Super+Shift+N clears all.

[global]
    monitor = 0
    follow = mouse
    width = (280, 360)
    height = (0, 220)
    origin = top-right
    offset = (12, 12)
    scale = 0
    notification_limit = 5
    gap_size = 8

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 340
    progress_bar_corner_radius = 3
    highlight = "#ffcfdf"

    indicate_hidden = yes
    transparency = 0
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 1
    frame_color = "#4d3546"
    separator_color = frame
    corner_radius = 12
    sort = yes
    idle_threshold = 120

    font = Adwaita Sans 10
    line_height = 2
    markup = full
    format = "<span foreground='#ffcfdf' weight='bold'>%s</span>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    word_wrap = yes

    icon_position = left
    icon_theme = "breeze-dark, Adwaita"
    enable_recursive_icon_lookup = true
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 6

    sticky_history = yes
    history_length = 50
    browser = /usr/bin/xdg-open
    dmenu = /usr/bin/rofi -dmenu -p dunst
    always_run_script = true
    ignore_dbusclose = false
    force_xinerama = false
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1a1419eb"
    foreground = "#b5aab1"
    timeout = 6

[urgency_normal]
    background = "#1a1419eb"
    foreground = "#ded6db"
    timeout = 8
    override_pause_level = 30

[urgency_critical]
    background = "#2a1418f2"
    foreground = "#ffe3dc"
    frame_color = "#ff7359"
    highlight = "#ff7359"
    timeout = 0
    override_pause_level = 60
