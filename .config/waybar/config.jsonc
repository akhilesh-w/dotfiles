// -*- mode: jsonc -*-
[{
    "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 34,
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "idle_inhibitor",
        "group/stats",
        "wireplumber",
        "backlight",
        "network",
        "bluetooth",
        "custom/power-mode",
        "custom/charge-limit",
        "battery",
        "clock",
        "custom/help",
        "tray"
    ],
    // CPU stays visible. Hover it to slide out memory, temperature and load.
    "group/stats": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "stats-child",
            "transition-left-to-right": false
        },
        "modules": ["cpu", "memory", "temperature", "load"]
    },
    "network": {
        "interval": 5,
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰤫",
        "format-disconnected": "󰤮",
        "format-disabled": "󰖪",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid}   {signalStrength}%\n{ipaddr}   {frequency} GHz\n⇣ {bandwidthDownBytes}   ⇡ {bandwidthUpBytes}\n\nClick: Wi-Fi menu   Right-click: settings",
        "tooltip-format-ethernet": "{ifname}   {ipaddr}\n⇣ {bandwidthDownBytes}   ⇡ {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Not connected\nClick to pick a network",
        "tooltip-format-disabled": "Wi-Fi is off\nClick to turn it on",
        "on-click": "/home/dopamine/.scripts/wifi-menu.sh",
        "on-click-right": "nm-connection-editor"
    },
    // Click cycles power saver / balanced / performance.
    "custom/power-mode": {
        "exec": "/home/dopamine/.scripts/power-mode.sh --waybar",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "on-click": "/home/dopamine/.scripts/power-mode.sh --cycle"
    },
    // Click toggles Lenovo conservation mode (stop charging around 60%).
    "custom/charge-limit": {
        "exec": "/home/dopamine/.scripts/charge-limit.sh --waybar",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "on-click": "/home/dopamine/.scripts/charge-limit.sh"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-no-controller": "",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "Bluetooth on, nothing connected\nClick to connect a device",
        "tooltip-format-off": "Bluetooth off\nClick to turn it on",
        "tooltip-format-disabled": "Bluetooth off\nClick to turn it on",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}   {device_battery_percentage}%",
        "on-click": "/home/dopamine/.scripts/bluetooth-menu.sh"
    },
    // Modules configuration
    "hyprland/workspaces": {
        "all-outputs": true,
        "warp-on-scroll": false,
        "enable-bar-scroll": true,
        "disable-scroll-wraparound": true,
        "format": "{name}"
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "all-outputs": true
    },
    "cava": {
	"cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
	"framerate": 30,
	"autosens": 1,
	"bars": 14,
	"lower_cutoff_freq": 50,
	"higher_cutoff_freq": 10000,
	"method": "pipewire",
	"source": "auto",
	"stereo": true,
	"bar_delimiter": 0,
	"noise_reduction": 0.77,
	"input_delay": 2,
        "hide_on_silence": true,
	"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
	"actions": {
	    "on-click-right": "mode"
	}
    },
    "mpris": {
 	"format": " {status_icon} {dynamic}",
        "interval": 1,
        "dynamic-len": 44,
        "max-length": 56,
	"status-icons": {
		"playing": "▶",
		"paused": "⏸",
		"stopped": ""
	},
	"dynamic-order": ["title", "artist"],
	"ignored-players": ["firefox", "brave"]
    },
    "custom/help": {
        "format": "?",
        "tooltip": true,
        "tooltip-format": "Keyboard shortcuts\nClick for the full guide",
        "on-click": "/home/dopamine/.scripts/shortcuts.sh"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "hyprland/mode": {
        "format": "{}"
    },
    "hyprland/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 10
    },
    "load": {
        "format": " {}"
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["󱃃", "󰔏", "󱃂"]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-alt": "{icon} {time}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "wireplumber": {
        "scroll-step": 5, // %, can be a float
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "󰝟 {icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "swayosd-client --output-volume mute-toggle"
    },
}]
